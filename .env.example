# ==============================================================================
# SOKETAEO - CONFIGURATION & CREDENTIALS (.env)
# ==============================================================================
# Заполни нужные поля своими ключами. Если какой-то сервис пока не подключен,
# оставь значение пустым — система автоматически пропустит его и будет слушать
# только активные сервисы.

# ------------------------------------------------------------------------------
# 1. КУДА ПРИСЫЛАТЬ НАЙДЕННЫЕ ЛИДЫ (TELEGRAM ALERT BOT)
# ------------------------------------------------------------------------------
# Токен бота из @BotFather (например: 7123456789:AAFxxx...)
TELEGRAM_NOTIFY_BOT_TOKEN=

# Твой цифровой ID пользователя или ID группы/канала из @userinfobot (например: 123456789 или -100123456789)
TELEGRAM_NOTIFY_CHAT_ID=
THREAD_ID=13


# ------------------------------------------------------------------------------
# 2. TELEGRAM ПАРСЕР (Чтение всех твоих групп и чатов через Telethon)
# ------------------------------------------------------------------------------
# Получить на https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Твой номер телефона с кодом страны (например: +79991234567 или +77011234567)
TELEGRAM_PHONE=


# ------------------------------------------------------------------------------
# 3. REDDIT API (Мониторинг постов и обсуждений)
# ------------------------------------------------------------------------------
# Создать приложение на https://www.reddit.com/prefs/apps (тип: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=soketaeo:lead_finder:v1.0
# Сабреддиты для мониторинга через запятую
REDDIT_SUBREDDITS=SEO,marketing,digital_marketing,SaaS,startups,entrepreneur,smallbusiness,growth,PPC


# ------------------------------------------------------------------------------
# 4. BLUESKY (AT Protocol)
# ------------------------------------------------------------------------------
# Регистрация на https://bsky.app
# Пароль приложения: Settings -> Privacy and Security -> App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=


# ------------------------------------------------------------------------------
# 5. DISCORD (Мониторинг каналов и серверов)
# ------------------------------------------------------------------------------
# Токен из https://discord.com/developers/applications (Bot Token) или User Token
DISCORD_TOKEN=
# true если используешь User Token своего аккаунта, false если это Bot Token
DISCORD_IS_USER_TOKEN=false


# ------------------------------------------------------------------------------
# 6. SLACK (Мониторинг воркспейсов)
# ------------------------------------------------------------------------------
# Создать App на https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_TOKEN=


# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
