# ==========================================
# SOKETAEO - Configuration & Credentials
# ==========================================

# --- 1. Notification Target (Куда отправлять найденные лиды) ---
TELEGRAM_NOTIFY_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_NOTIFY_CHAT_ID=your_telegram_user_id_or_channel_id

# --- 2. Telegram (Telethon Client - чтение ваших чатов/групп) ---
# Получить на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_PHONE=+79991234567

# --- 3. Reddit API (PRAW) ---
# Получить на https://www.reddit.com/prefs/apps (Create App -> script)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=soketaeo:lead_finder:v1.0 (by /u/your_username)
REDDIT_SUBREDDITS=SEO,marketing,digital_marketing,SaaS,entrepreneur,startups,smallbusiness

# --- 4. Bluesky (AT Protocol / Jetstream) ---
# Регистрация на https://bsky.app. App Password: Settings -> Privacy and Security -> App Passwords
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- 5. Discord ---
# Bot token (https://discord.com/developers/applications) или User Token (через DevTools)
DISCORD_TOKEN=your_discord_token
DISCORD_IS_USER_TOKEN=false

# --- 6. Slack ---
# Получить в https://api.slack.com/apps (User OAuth Token: xoxp-... или Bot Token: xoxb-...)
SLACK_USER_TOKEN=xoxp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- 7. Search Keywords (Ключевые фразы для мониторинга) ---
KEYWORDS_AEO_GEO=AEO,GEO,Answer Engine Optimization,Generative Engine Optimization,AI SEO,rank in ChatGPT,rank on Perplexity,ChatGPT SEO,Perplexity SEO,SearchGPT,AI search,оптимизация под нейросети,ранжирование в chatgpt
KEYWORDS_TARGET=target ads,targetologist,facebook ads,meta ads,google ads specialist,таргетолог,таргет сша,таргет рф,трафик в сша,запуск таргета,нужен таргетолог,ищу таргетолога,ищу контекстолога
